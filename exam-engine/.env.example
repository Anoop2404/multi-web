# Exam engine configuration (CONTRACT.md §9 plus engine extras). The binary reads the environment;
# systemd loads this file via EnvironmentFile=. Never commit real tokens.

# Listen address.
EXAM_ENGINE_ADDR=:8090

# Redis (redis://[user:password@]host:port/db, or rediss:// for TLS). Locally use database 14 so the
# engine stays away from Laravel's database 0.
EXAM_ENGINE_REDIS_URL=redis://127.0.0.1:6379/14
# Sentinel (optional): comma-separated sentinel addresses + master name. The password and database
# still come from EXAM_ENGINE_REDIS_URL.
#EXAM_ENGINE_REDIS_SENTINELS=10.122.0.2:26379,10.122.0.3:26379
#EXAM_ENGINE_REDIS_MASTER=exam
# Redis connection pool (default 32 × CPU cores).
#EXAM_ENGINE_REDIS_POOL_SIZE=256

# Bearer token Laravel sends on /internal/* (same value as Laravel's EXAM_ENGINE_INTERNAL_TOKEN).
# Generate with: openssl rand -hex 32
EXAM_ENGINE_INTERNAL_TOKEN=

# Ed25519 public key for portal launch tokens: the value `php artisan exam-engine:keys` prints
# (base64, 32 bytes). Laravel keeps the matching EXAM_ENGINE_LAUNCH_SECRET_KEY. Empty = launch off.
EXAM_ENGINE_LAUNCH_PUBLIC_KEY=

# Built client to serve. Empty = the copy embedded at build time (internal/web/dist, `make client`).
#EXAM_ENGINE_STATIC_DIR=/opt/exam-engine/client

# Where students fetch the encrypted paper (CDN base in Stage B). Default /api/bundle.
#EXAM_ENGINE_BUNDLE_BASE_URL=https://exam.example.org/api/bundle

# Behind Cloudflare / a load balancer: take the client IP from CF-Connecting-IP, then the left-most
# X-Forwarded-For entry, and treat X-Forwarded-Proto=https as HTTPS (Secure cookie).
#EXAM_ENGINE_TRUST_PROXY=true

# Password logins: bcrypt workers (default = CPU cores), how long a login waits for a worker before
# 503 busy, and how many may queue.
#EXAM_ENGINE_BCRYPT_WORKERS=4
#EXAM_ENGINE_BCRYPT_MAX_WAIT_SECONDS=20
#EXAM_ENGINE_BCRYPT_MAX_QUEUE=5000

# Automatic pacing: next_sync_in rises to 20 / 30 / 60 s when this node's in-flight student requests
# exceed these numbers.
#EXAM_ENGINE_PACE_THRESHOLDS=500,1500,3000

# Events (ex:events). 0 = no cap: entries are trimmed only after Laravel has received and
# acknowledged them. A positive value is a hard safety cap (XADD MAXLEN ~) that CAN drop unconsumed
# events — only for protecting Redis memory in an emergency.
#EXAM_ENGINE_EVENTS_HARD_CAP=0
# attempt.snapshot at most this often per changed attempt (minimum 120). Submitted events carry the
# full answers, so snapshots are only a safety copy.
#EXAM_ENGINE_SNAPSHOT_SECONDS=300

# How long a node caches run meta/messages/pace (ms). Admin writes take effect on other nodes within this.
#EXAM_ENGINE_RUN_CACHE_MS=1000

# debug | info | warn | error (JSON logs on stdout; passwords and passcodes are never logged).
#EXAM_ENGINE_LOG_LEVEL=info
