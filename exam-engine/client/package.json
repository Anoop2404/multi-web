{
    "name": "sahodaya-exam-client",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "description": "Student exam client (login, check-in, waiting room, exam, result) served by the Go exam engine.",
    "scripts": {
        "dev": "vite",
        "dev:mock": "EXAM_MOCK=1 vite",
