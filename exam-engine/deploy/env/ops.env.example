# exam-engine/deploy/env/ops.env -- settings for the scripts in ../scripts (sourced by bash).
# Copy to env/ops.env (gitignored) and fill in. Paths are relative to exam-engine/deploy/ unless absolute.
# Override the file location with OPS_ENV=/path/to/ops.env.

# --- DigitalOcean --------------------------------------------------------------------------
# doctl auth context holding a token for the exam team/project (`doctl auth init --context exam`).
DO_CONTEXT=exam
DO_REGION=blr1
# `doctl vpcs list` -- the BLR1 VPC that holds the exam droplets and the LB.
DO_VPC_UUID=CHANGE_ME_VPC_UUID
# Comma-separated SSH key IDs or fingerprints (`doctl compute ssh-key list`).
DO_SSH_KEYS=CHANGE_ME_SSH_KEY_ID
# Optional: `doctl projects list`; new droplets are created in this project.
DO_PROJECT_ID=

# --- Tags (the LB targets ENGINE_LB_TAG; never rename casually) ----------------------------
ENGINE_LB_TAG=exam-engine
ENGINE_NODE_TAG=exam-engine-node
ENGINE_BASE_TAG=exam-engine-base
ENGINE_BURST_TAG=exam-engine-burst
ENGINE_DRAIN_TAG=exam-engine-draining
REDIS_TAG=exam-redis
REDIS_BASE_TAG=exam-redis-base
REDIS_BURST_TAG=exam-redis-burst
MONITOR_TAG=exam-monitor

# --- Engine nodes --------------------------------------------------------------------------
# Always-on node (created by hand, README step 5) and burst nodes (scale-out.sh).
ENGINE_BASE_NAME=exam-engine-1
ENGINE_BASE_SIZE=c-2
ENGINE_BURST_SIZE=c-4
ENGINE_BURST_PREFIX=exam-engine-burst
MAX_ENGINE_NODES=12
# Golden image: built on a small 25 GB-disk droplet so the snapshot fits every size we use.
ENGINE_IMAGE_BUILD_SIZE=s-1vcpu-1gb
ENGINE_SNAPSHOT_PREFIX=exam-engine-image
# Empty = newest snapshot whose name starts with ENGINE_SNAPSHOT_PREFIX.
ENGINE_SNAPSHOT_ID=
ENGINE_ENV_FILE=env/engine.env
# Release to install on new/updated nodes. Preferred: a local tarball from build-release.sh,
# pushed over SSH (no download host needed). Alternative: an HTTPS URL + sha256 the node downloads.
ENGINE_RELEASE_TARBALL=
ENGINE_RELEASE_URL=
ENGINE_RELEASE_SHA256=
INSTALL_NODE_EXPORTER=yes

# --- Redis -----------------------------------------------------------------------------------
REDIS_BASE_NAME=redis-exam-1
REDIS_BASE_SIZE=s-2vcpu-4gb
REDIS_LARGE_SIZE=s-4vcpu-8gb
REDIS_BURST_NAME=redis-exam-burst
# One line, hex only: openssl rand -hex 32 > env/redis.password
REDIS_PASSWORD_FILE=env/redis.password
# no = Stage A (engines use EXAM_ENGINE_REDIS_URL). yes = Stage B (after resize-redis.sh sentinel-setup).
REDIS_SENTINEL=no
REDIS_MASTER_NAME=exam
# failover | offline; empty = failover when REDIS_SENTINEL=yes, else offline (power-cycle resize).
REDIS_RESIZE_METHOD=
INSTALL_REDIS_EXPORTER=yes

# --- Load balancer -----------------------------------------------------------------------------
# do = DigitalOcean LB (tag-based) | haproxy = HAProxy droplet | nginx = Stage A-lite, no LB.
LB_KIND=do
# `doctl compute load-balancer list` (LB_KIND=do)
LB_ID=CHANGE_ME_LB_ID
# SSH host (public IP) of the HAProxy droplet (LB_KIND=haproxy)
HAPROXY_HOST=
# Public exam site (Cloudflare -> LB). Used for health checks through the whole path.
EXAM_PUBLIC_URL=https://exam.example.org
# Seconds to wait after a node turns healthy so the LB health check (3 x 10 s) admits it.
LB_ADMIT_SECONDS=40
# Seconds to keep a node out of the LB before stopping it (scale-in, rolling-update).
DRAIN_SECONDS=60

# --- SSH ---------------------------------------------------------------------------------------
OPS_SSH_USER=ops
# Optional private key for the exam fleet.
SSH_IDENTITY=
# Host running Prometheus/Alertmanager (private-network scrapes). Empty = skip the check.
MONITOR_HOST=

# --- Laravel (aaPanel server) -----------------------------------------------------------------
# user@host for SSH, or "local" when these scripts run on the aaPanel server itself.
LARAVEL_SSH=root@CHANGE_ME_AAPANEL_HOST
LARAVEL_PATH=/www/wwwroot/sahodaya.truecampus.in
# How to run artisan there (as the web user, never as root -- root-owned files break the site).
LARAVEL_ARTISAN="sudo -u www php artisan"
# Extra arguments for `exam-engine:plan-capacity` if it needs any (e.g. --json).
PLAN_CAPACITY_ARGS=
SUPERVISORCTL=supervisorctl
CONSUMER_PROGRAM=exam-engine-consumer

# --- Automation (plan-and-scale.sh) -------------------------------------------------------
# Scale out this long before a slot starts. A slot starts when its waiting room opens (T0 - 60 min),
# so 120 = T0 - 3h (plan section 9).
SCALE_LEAD_MINUTES=120
# Keep the capacity this long after a slot's window ends.
SCALE_TAIL_MINUTES=30
# A slot with more booked students than this gets the Redis replica (Stage B).
REDIS_LARGE_THRESHOLD=2000
# yes = plan-and-scale.sh also runs resize-redis.sh up/down.
REDIS_AUTO_RESIZE=no
# scale-in.sh refuses to leave fewer than writing/this nodes (unless --force).
SCALE_IN_WRITING_PER_NODE=2000
# While this file exists, nothing is scaled in (create it during incidents).
HOLD_FILE=.state/hold-scale-in
