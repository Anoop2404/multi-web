# /etc/exam-engine/engine.env -- exam engine configuration (exam-engine/CONTRACT.md section 9).
#
# Copy to exam-engine/deploy/env/engine.env (gitignored) and fill in. The scripts push this one file to
# every engine node (cloud-init user-data at boot, rolling-update.sh --env afterwards), so all nodes
# always run with identical settings. On the node: owner root:exam, mode 0640.
#
# systemd EnvironmentFile rules: one KEY=value per line, no `export`, no quotes needed,
# and NO trailing comments on a value line (they would become part of the value).
# Placeholders below are CHANGE_ME_*; never commit real values.

# Listen address. Behind the DigitalOcean LB the LB reaches the node's private IP on 8090
# (the cloud firewall only allows the LB and the monitor node). Stage A-lite (nginx on the same
# droplet): use 127.0.0.1:8090.
EXAM_ENGINE_ADDR=:8090

# --- Redis -------------------------------------------------------------------------------
# Stage A: direct connection to redis-exam-1 over the VPC (private IP), password from
# env/redis.password (hex, `openssl rand -hex 32`). DB 0. Use rediss:// if Redis TLS is enabled.
EXAM_ENGINE_REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@10.122.0.2:6379/0

# Stage B: after `scripts/resize-redis.sh sentinel-setup`, switch to Sentinel (keep REDIS_URL for the
# password; the engine asks the sentinels for the current primary). Sentinels run on redis-exam-1
# and exam-engine-1 (fixed private IPs); a burst replica adds a third one automatically.
#EXAM_ENGINE_REDIS_SENTINELS=10.122.0.2:26379,10.122.0.3:26379
#EXAM_ENGINE_REDIS_MASTER=exam

# --- Laravel <-> engine ------------------------------------------------------------------
# Bearer token for /internal/* (same value as Laravel's EXAM_ENGINE_INTERNAL_TOKEN).
# Generate: openssl rand -hex 32
EXAM_ENGINE_INTERNAL_TOKEN=CHANGE_ME_64_HEX_CHARS

# Ed25519 public key (base64, 32 bytes) for portal launch tokens. Laravel keeps the secret half in
# EXAM_ENGINE_LAUNCH_SECRET_KEY. Generate the pair with `php artisan exam-engine:keys`.
EXAM_ENGINE_LAUNCH_PUBLIC_KEY=CHANGE_ME_BASE64_PUBLIC_KEY

# --- Client and paper bundles -------------------------------------------------------------
# The release tarball ships the built client next to the binary; pointing at it guarantees the
# client always matches the engine version (unset = the copy embedded in the binary).
EXAM_ENGINE_STATIC_DIR=/opt/exam-engine/current/client

# Where clients fetch encrypted paper bundles. Default /api/bundle is served by the engine and
# cached by Cloudflare (cache rule in cloudflare/README.md). Only change for an R2/CDN publisher.
EXAM_ENGINE_BUNDLE_BASE_URL=/api/bundle

# --- Proxy, pacing, login pool -------------------------------------------------------------
# Trust X-Forwarded-For: requests always arrive via Cloudflare -> LB (or nginx/HAProxy), which put
# the student's IP first. The LB/cloud firewall only admits Cloudflare and the monitor node.
EXAM_ENGINE_TRUST_PROXY=true

# bcrypt worker pool size; default = CPU cores. Leave unset unless the load test says otherwise.
#EXAM_ENGINE_BCRYPT_WORKERS=4

# In-flight request thresholds at which next_sync_in is raised to 20 / 30 / 60 s.
EXAM_ENGINE_PACE_THRESHOLDS=500,1500,3000

# --- Go runtime ---------------------------------------------------------------------------
# Soft heap limit. All engine nodes share this file, so size it for the smallest node
# (c-2 = 4 GB RAM). Engine state lives in Redis; the heap normally stays small.
GOMEMLIMIT=2800MiB
