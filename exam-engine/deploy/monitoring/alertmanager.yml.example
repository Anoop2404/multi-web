# /etc/prometheus/alertmanager.yml -- where exam alerts go. Ubuntu: prometheus-alertmanager (0.26).
# Fill in placeholders; keep secrets in files readable only by the prometheus user.
# Critical alerts page the platform on-call (Telegram/phone); warnings go to email.

global:
  resolve_timeout: 5m
  smtp_smarthost: "smtp.example.org:587"
  smtp_from: "exam-alerts@example.org"
  smtp_auth_username: "exam-alerts@example.org"
  smtp_auth_password_file: /etc/prometheus/smtp_password
  smtp_require_tls: true

route:
  receiver: email-oncall
  group_by: [alertname]
  group_wait: 30s
  group_interval: 2m
  repeat_interval: 1h
  routes:
    - matchers: [severity="critical"]
      receiver: telegram-oncall
      repeat_interval: 15m
      continue: true
    - matchers: [severity="critical"]
      receiver: email-oncall

receivers:
  - name: email-oncall
    email_configs:
      - to: "platform-oncall@example.org"
        send_resolved: true

  - name: telegram-oncall
    telegram_configs:
      - bot_token_file: /etc/prometheus/telegram_bot_token
        chat_id: -1001234567890
        parse_mode: HTML
        send_resolved: true

inhibit_rules:
  # A node that is down also stops reporting its own symptoms.
  - source_matchers: [alertname="ExamEngineNodeDown"]
    target_matchers: [alertname=~"ExamEngineCpuSaturated|ExamSyncLatencyHigh"]
    equal: [instance]
  - source_matchers: [alertname="RedisDown"]
    target_matchers: [alertname=~"RedisMemoryHigh|RedisSlowEval"]
    equal: [instance]
