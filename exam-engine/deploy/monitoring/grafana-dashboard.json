        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(exam_http_requests_total{route=~\"sync|resync|login|start|submit|state|system_check|result\"}[1m]))",
          "legendFormat": "{{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
