<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="central"/>
        <env name="DB_DRIVER" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="TENANCY_DATABASE_PER_SAHODAYA" value="false"/>
        <env name="STATE_APP_DOMAIN" value="state.localhost"/>
        <env name="STATE_DB_DRIVER" value="sqlite"/>
        <env name="STATE_DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Force the deterministic DomPDF fallback regardless of a developer's local
             .env — without this override, tests silently depend on whatever PDF-rendering
             service (or lack of one) happens to be reachable at PDF_CONVERTER_URL on the
             machine running them, which is exactly the kind of environment-dependent
             flakiness a test suite should never have. -->
        <env name="PDF_CONVERTER_URL" value=""/>
        <env name="UPLOAD_DISK" value="shared"/>
        <env name="AWS_ACCESS_KEY_ID" value=""/>
        <env name="AWS_SECRET_ACCESS_KEY" value=""/>
        <env name="AWS_BUCKET" value=""/>
        <env name="CENTRAL_DOMAIN" value="superadmin.test"/>
        <env name="TENANT_BASE_DOMAIN" value="sahodaya.test"/>
    </php>
</phpunit>
